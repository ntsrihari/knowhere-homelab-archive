# Immich v3.1.0 migration settings. Copy to .env and set a unique DB_PASSWORD.
# Keep these existing container paths: the restored database references /data and /mnt/photos.
UPLOAD_LOCATION=/mnt/immich/ImmichData
EXTERNAL_LIBRARY_LOCATION=/mnt/immich/Photos
DB_DATA_LOCATION=/srv/appdata/immich/postgres
TZ=Asia/Kolkata
IMMICH_VERSION=v3.1.0

# Replace with a random alphanumeric secret before starting the database.
DB_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC_PASSWORD
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
