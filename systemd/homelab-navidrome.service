[Unit]
Description=Navidrome Compose Stack
Requires=docker.service
After=docker.service
RequiresMountsFor=/mnt/media/Media/Music /mnt/internal-hdd/MUSIC

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/homelab/navidrome
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
