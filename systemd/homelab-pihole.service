[Unit]
Description=Pi-hole DNS Filtering (Compose)
Requires=docker.service tailscaled.service
After=docker.service tailscaled.service
RequiresMountsFor=/srv/appdata/pihole/etc-pihole

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/homelab/pihole
ExecStartPre=/bin/sh -ec '. ./.env; case "$PIHOLE_IP" in ""|REPLACE_WITH_LAN_IP) echo "Set PIHOLE_IP in /opt/homelab/pihole/.env" >&2; exit 1;; esac; case "$PIHOLE_TAILSCALE_IP" in ""|REPLACE_WITH_TAILSCALE_IP) echo "Set PIHOLE_TAILSCALE_IP in /opt/homelab/pihole/.env" >&2; exit 1;; esac; /usr/sbin/ip -o -4 addr show | awk "{print \$4}" | cut -d/ -f1 | grep -Fx "$PIHOLE_IP"; /usr/bin/tailscale ip -4 | grep -Fx "$PIHOLE_TAILSCALE_IP"; test -d /srv/appdata/pihole/etc-pihole'
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
