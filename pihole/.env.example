# LAN IPv4 of knowhere. This address is currently DHCP-assigned; reserve it in router only if/when router changes are allowed.
PIHOLE_IP=REPLACE_WITH_LAN_IP

# Tailscale IPv4 of knowhere (run `tailscale ip -4` on the server to confirm).
PIHOLE_TAILSCALE_IP=REPLACE_WITH_TAILSCALE_IP

# Set to a long random password; do not commit the real .env.
PIHOLE_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
